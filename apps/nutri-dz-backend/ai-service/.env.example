# Chat / meal-plan / food-photo model (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Nutrition-label OCR vision provider (Groq by default; any OpenAI-compatible API).
# Groq free keys: https://console.groq.com  — confirm the current vision model id
# with GET {VISION_BASE_URL}/models (exposed internally as /ai/vision-models).
VISION_API_KEY=your-groq-key-here
VISION_BASE_URL=https://api.groq.com/openai/v1
VISION_MODEL=qwen/qwen3.8-27b
