{
  "expo": {
    "name": "NutriDz",
    "slug": "nutridz",
    "version": "1.0.0",
    "scheme": "nutridz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A7D3E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutridz.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A7D3E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nutridz.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5710de3-8fc4-4ecd-a1ed-82ce2fe80e69"
      }
    },
    "owner": "samdem-ai"
  }
}
